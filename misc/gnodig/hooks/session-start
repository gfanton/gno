#!/usr/bin/env bash
# SessionStart hook for gnodig plugin
# Injects investigation discipline rules at every session start.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="When the investigating skill activates, you MUST follow these rules:\n\n"
context+="1. Use TaskCreate to create a task for EACH checklist item. Mark in_progress when starting, completed when done.\n"
context+="2. Tag EVERY finding: [observed], [inferred], or [speculative]. No exceptions.\n"
context+="3. NEVER prescribe chain-affecting actions (gnobr, restart, state patches) based on [speculative] findings.\n"
context+="4. After EVERY MCP tool call, update the gap list (what is still unknown).\n"
context+="5. When context shifts (fix applied, new evidence), start a new pass — do NOT carry confidence forward.\n\n"
context+="These rules are non-negotiable. Read the full investigating skill for details."

escaped=$(escape_for_json "$context")
session_context="<gnodig-discipline>\n${escaped}\n</gnodig-discipline>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
